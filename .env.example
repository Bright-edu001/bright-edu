# 環境變數範本文件
# 複製此文件為 .env.local 並填入實際值

# API 端點
VITE_API_URL=https://your-backend-url.com

# Firebase Configuration
VITE_API_KEY="your-firebase-api-key"
VITE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_PROJECT_ID="your-project-id"
VITE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_MESSAGING_SENDER_ID="your-sender-id"
VITE_APP_ID="your-app-id"
VITE_MEASUREMENT_ID="your-measurement-id"
VITE_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"

# Google Sheets 同步服務配置
# 注意：所有 VITE_ 變數都會被打包到前端，使用者可在瀏覽器中取得。
# VITE_SYNC_API_KEY 僅作為前端傳送的 guard/config 值，不是可保密的伺服器端 secret。
VITE_SYNC_API_KEY=your-sync-api-key
VITE_SYNC_SERVICE_URL=https://your-sync-service-url
VITE_DEV_SYNC_SERVICE_URL=http://localhost:3002

# Sentry 錯誤回報
VITE_SENTRY_DSN=your-sentry-dsn

# Firebase Emulator（本機離線測試用）
# 設為 true 可連接本機 Firebase Emulator（Auth port 9099、Firestore port 8080、Storage port 9199）
# 若本機未設定 VITE_API_KEY 且在 localhost 執行 DEV 模式，系統會自動套用模擬器佔位設定
VITE_USE_FIREBASE_EMULATOR=false
